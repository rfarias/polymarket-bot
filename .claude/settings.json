    "deny": [
      "Bash(python run_live_*)",
      "Bash(python run_guarded_bot*)",
      "Bash(python run_multi_setup_bot*)",
      "Bash(python run_portfolio_settlement*)",
      "Bash(powershell *watch_next1*)",
