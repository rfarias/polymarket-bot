{
  "manifest_version": 3,
  "name": "Polymarket EL Monitor V1",
  "version": "1.3.2",
  "description": "Monitora Early Leader e sinal EE em tempo real na página da Polymarket.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://polymarket.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*"
  ]
}
